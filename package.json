{
  "name": "faan-ict-maintenance-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "start": "npm start --workspace server",
    "test": "npm run test --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:deploy": "npm run db:deploy --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:turso": "npm run db:turso --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  }
}
