generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         String       @default("TECHNICIAN")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reported     FaultReport[] @relation("ReportedBy")
  assigned     FaultReport[] @relation("AssignedTo")
  maintenance  MaintenanceRecord[]
}

model Staff {
  id          String      @id @default(cuid())
  name        String
  staffId     String      @unique
  department  String
  email       String?
  phone       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  equipment   Equipment[]
}

model Equipment {
  id          String              @id @default(cuid())
  assetNumber String              @unique
  name        String
  category    String
  brand       String?
  model       String?
  serialNumber String?
  department  String
  location    String
  assignedStaffId String?
  purchaseDate DateTime?
  condition   String              @default("OPERATIONAL")
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignedStaff Staff?            @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  faults      FaultReport[]

  @@index([condition, category])
  @@index([department, location])
}

model FaultReport {
  id                  String       @id @default(cuid())
  reference           String       @unique
  equipmentId         String
  title               String
  description         String
  priority            String       @default("MEDIUM")
  reportedById        String
  assignedTechnicianId String?
  status              String       @default("REPORTED")
  reportedAt          DateTime     @default(now())
  resolvedAt          DateTime?
  resolutionSummary   String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  equipment           Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  reportedBy          User         @relation("ReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedTechnician  User?        @relation("AssignedTo", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  maintenance         MaintenanceRecord[]

  @@index([equipmentId, status])
  @@index([status, priority])
  @@index([assignedTechnicianId, status])
  @@index([reportedAt])
}

model MaintenanceRecord {
  id            String      @id @default(cuid())
  faultId       String
  technicianId  String
  performedAt   DateTime    @default(now())
  workPerformed String
  partsReplaced String?
  costNaira     Float?
  outcome       String
  notes         String?
  createdAt     DateTime   @default(now())
  fault         FaultReport @relation(fields: [faultId], references: [id], onDelete: Restrict)
  technician   User        @relation(fields: [technicianId], references: [id], onDelete: Restrict)

  @@index([faultId, performedAt])
  @@index([performedAt])
}
