# Copy to .env for local development. Replace SESSION_SECRET before deployment.
DATABASE_URL="file:./faan.db"
SESSION_SECRET="replace-this-with-at-least-32-random-characters"
NODE_ENV="development"
PORT=4000

# Only used by the Vercel deployment, which reads the database from Turso
# instead of a local file. Leave empty locally, see README "Deploying to Vercel".
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
